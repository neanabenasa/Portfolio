@page "/education"

<PageTitle>Education | Nean Mae Abenasa</PageTitle>

<div class="education-container fade-in">
    <div class="header-section">
        <h1 class="neon-text">>_ ACADEMIC_RECORDS</h1>
        <p class="sys-msg">Decrypting educational history files...</p>
    </div>

    <div class="timeline mt-5">
        
        <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
                <h3 class="level-title">Tertiary / College</h3>
                <h4 class="school-name">Cebu Technological University - DB Campus</h4>
                <div class="years-badge">Present</div>
                <p class="details">> Course: Bachelor of Science in Information Technology (BSIT)</p>
                <p class="details">> Highlights: Focused on programming, database management, and web development</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
                <h3 class="level-title">Senior High School</h3>
                <h4 class="school-name">Bateria National High School</h4>
                <div class="years-badge">Completed</div>
                <p class="details">> Strand: GAS (General Academic Strand)</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
                <h3 class="level-title">Junior High School</h3>
                <h4 class="school-name">Bateria National High School</h4>
                <div class="years-badge">Completed</div>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
                <h3 class="level-title">Elementary</h3>
                <h4 class="school-name">Bateria Elementary School</h4>
                <div class="years-badge">Completed</div>
            </div>
        </div>

    </div>
</div>

<style>
    .education-container {
        padding: 2rem 0;
        max-width: 800px;
        margin: 0 auto;
    }

    .header-section {
        text-align: center;
        margin-bottom: 3rem;
    }

    .neon-text {
        color: #fff;
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        text-shadow: 
            0 0 5px #ff2a9d,
            0 0 10px #ff2a9d,
            0 0 20px #b800ff;
        margin-bottom: 0.5rem;
        font-family: 'Courier New', Courier, monospace;
    }

    .sys-msg {
        color: #b800ff;
        font-style: italic;
        font-family: 'Courier New', Courier, monospace;
    }

    /* Timeline Structure */
    .timeline {
        position: relative;
        padding-left: 2rem;
        border-left: 2px solid rgba(184, 0, 255, 0.5);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 3rem;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: -2.4rem;
        top: 0;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: #ff2a9d;
        box-shadow: 0 0 10px #ff2a9d, 0 0 20px #b800ff;
        border: 2px solid #0b0014;
    }

    .timeline-content {
        background-color: #1a0029;
        border: 1px solid #4a0072;
        border-radius: 8px;
        padding: 1.5rem 2rem;
        box-shadow: 0 5px 15px rgba(184, 0, 255, 0.1);
        transition: all 0.3s ease;
        position: relative;
    }

    .timeline-content:hover {
        border-color: #ff2a9d;
        box-shadow: 0 5px 20px rgba(255, 42, 157, 0.3);
        transform: translateX(5px);
    }

    .level-title {
        color: #c9a3ff;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 0.5rem;
    }

    .school-name {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    }

    .years-badge {
        display: inline-block;
        background-color: rgba(255, 42, 157, 0.1);
        color: #ff2a9d;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        border: 1px solid rgba(255, 42, 157, 0.3);
        margin-bottom: 1rem;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
    }

    .details {
        color: #f2e6ff;
        margin-bottom: 0.5rem;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.95rem;
    }

    .fade-in {
        animation: fadeIn 0.8s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 1; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>